{
  "rewrites": [
    { "source": "/", "destination": "/video.html" },
    { "source": "/illustrated", "destination": "/index.html" },
    { "source": "/video", "destination": "/video.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
